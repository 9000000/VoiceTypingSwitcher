#include <windows.h>
#include "version.h"

1 ICON "../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "VoiceTypingSwitcher"
      VALUE "ProductName", "VoiceTypingSwitcher"
      VALUE "FileVersion", APP_VER_STR
      VALUE "ProductVersion", APP_VER_STR
      VALUE "OriginalFilename", "VoiceTypingSwitcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
